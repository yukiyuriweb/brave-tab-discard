{
  "manifest_version": 3,
  "name": "Discard Inactive Tabs",
  "version": "0.1",
  "description": "アクティブなタブ以外をメモリから外す（クリックで再読み込み）",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "アクティブなタブ以外を外す",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
